<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Cloudly.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Cloudly"
    xmlns:views="clr-namespace:Cloudly.Views"
    Title="Cloudly" >

     <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="HomePage"
            Icon="home" />

        <ShellContent
            Title="Search"
            ContentTemplate="{DataTemplate views:SearchPage}"
            Route="SearchPage"
            Icon="search" />

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage"
            Icon="settings" />
    </TabBar>
</Shell>
